{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck*)", "Bash(pnpm lint*)", "Bash(pnpm test*)",
      "Bash(pnpm format*)", "Bash(pnpm build*)", "Bash(pnpm check*)",
      "Bash(pnpm docs:index*)",
      "Bash(pnpm --filter * test*)", "Bash(pnpm --filter * typecheck*)",
      "Bash(pnpm --filter * lint*)", "Bash(pnpm --filter * build*)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm exec supabase start*)", "Bash(pnpm exec supabase status*)",
      "Bash(pnpm exec supabase db reset --local*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(git add *)", "Bash(git commit *)",
      "Edit(./apps/**)", "Edit(./packages/**)", "Edit(./supabase/migrations/**)", "Edit(./docs/mvp/**)"
    ],
    "deny": [
      "Read(./**/.env)", "Read(./**/.env.*)",
      "Bash(git push --force*)", "Bash(pnpm exec supabase db push*)",
      "Bash(git checkout demo*)", "Bash(git merge demo*)"
    ]
  }
}
