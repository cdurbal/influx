{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    // Neither Node nor DOM: contracts have no process, no fetch, no console (21 §4, J1-E).
    "types": []
  },
  // Sources only: the types of vitest bring Node globals into any program that includes tests.
  "include": ["src"]
}
