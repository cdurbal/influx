{
  "name": "influx",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @influx/web dev",
    "dev:web": "pnpm --filter @influx/web dev",
    "dev:api": "pnpm --filter @influx/api dev",
    "dev:worker": "pnpm --filter @influx/api dev:worker",
    "dev:backoffice": "pnpm --filter @influx/backoffice dev",
    "db:role-passwords": "pnpm --filter @influx/test-kit db:role-passwords",
    "db:demo-accounts": "pnpm --filter @influx/api db:demo-accounts",
    "dev:brevo-double": "pnpm --filter @influx/test-kit dev:brevo-double",
    "start": "pnpm --filter @influx/web start",
    "start:web": "pnpm --filter @influx/web start",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r --filter=!@influx/api run test && pnpm --filter @influx/api test:unit",
    "test:e2e": "pnpm --filter @influx/web test:e2e",
    "docs:index": "node docs/mvp/build-index.mjs && prettier --write docs/mvp/INDEX.md",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm -r run test:artifacts",
    "check:fast": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:unit"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.122.0"
  }
}
