# =============================================================================
# INFLUX — apps/web environment variables (TEMPLATE: fake values only)
# =============================================================================
# Local development: copy this file to `apps/web/.env.local` (git-ignored),
# loaded natively by Next.js. Never commit a real value.
#
# Rules (skill `env-secrets`, docs/mvp/02 §12.3, docs/mvp/21 §4 J1-F):
# - Read in src/config/ only (ESLint), at request time, by the relay to
#   apps/api (src/app/api/[...path]/route.ts). `next build` needs none of them.
# - Never prefix a variable with NEXT_PUBLIC_: nothing here may reach the
#   browser. The front holds no Supabase, Brevo or Apollo key (02 §2.1).
# =============================================================================

# Private address of apps/api: an http(s) origin, without path or credentials.
# Local: http://localhost:3100. Railway: private address of the `api` service,
# port set explicitly (J4). Internal, not secret. Service: web.
INFLUX_API_INTERNAL_URL=http://localhost:3100

# Internal secret of the relay (x-influx-internal header, 03 PP-8). SECRET.
# Must equal INFLUX_API_INTERNAL_SECRET_WEB of apps/api, and differ from the
# backoffice value. At least 32 random bytes. Service: web.
# A value that still contains CHANGE_ME is refused (21 J1-J R4).
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
INFLUX_API_INTERNAL_SECRET=CHANGE_ME
