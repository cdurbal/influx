{
  "name": "@influx/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=test-results/vitest-report.json && node ../../packages/test-kit/scripts/check-case-floors.ts tests/case-floors.ts test-results/vitest-report.json",
    "test:artifacts": "vitest run --config vitest.artifacts.config.ts --reporter=default --reporter=json --outputFile.json=test-results/artifacts-report.json && node ../../packages/test-kit/scripts/check-case-floors.ts tests/artifact-floors.ts test-results/artifacts-report.json",
    "test:e2e": "playwright test && node ../../packages/test-kit/scripts/check-case-floors.ts e2e/case-floors.ts test-results/e2e-report.json",
    "e2e:record-vitrine": "playwright test e2e/vitrine-unchanged.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@influx/contracts": "workspace:*",
    "@influx/ui": "workspace:*",
    "@influx/web-platform": "workspace:*",
    "lucide-react": "1.46.0",
    "next": "16.3.6",
    "next-intl": "4.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@influx/test-kit": "workspace:*",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
