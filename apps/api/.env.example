# =============================================================================
# INFLUX — apps/api environment variables (TEMPLATE: fake values only)
# =============================================================================
# Local development: copy this file to `apps/api/.env.local` (git-ignored) and
# fill it with the values of the STAGING environment. Never commit a real value.
#
# Why `.env.local` and not `.env`: the throwaway demo (branch `demo`) auto-loads
# `apps/api/.env` and the root `.env`. Real keys must never be loaded by the
# demo (CLAUDE.md §16.2, rule 4).
#
# Rules (skill `env-secrets`, docs/mvp/02 §12.3, docs/mvp/16 §M8):
# - Every variable below is SERVER-ONLY: package `apps/api`, Railway services
#   `api` and `worker`. None may ever be prefixed `NEXT_PUBLIC_` or be read by
#   `apps/web` or `apps/backoffice`.
# - One distinct value per environment. Production values exist only in the
#   Railway `production` environment.
# - Brevo and Apollo production keys never exist in a local file (16 RG115).
#   Locally, only keys of dedicated Brevo and Apollo TEST accounts (D62).
# =============================================================================

# --- Platform ----------------------------------------------------------------
# `staging` | `production`. Read at startup, immutable. Services: all.
INFLUX_ENV=staging
# Public URL of the site. Services: web, api, worker.
INFLUX_PUBLIC_SITE_URL=http://localhost:3000
# Session cookie signing secret, at least 32 random bytes. Service: api.
# Rotating it logs everyone out.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_COOKIE_SECRET=CHANGE_ME

# --- Supabase ----------------------------------------------------------------
# One Supabase project per environment (02 §12.2). Local = staging project.
# Dashboard: Project Settings > API Keys.
# Project URL. Service: api.
SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable key" (sb_publishable_...) or legacy "anon" key. Service: api.
# Not a secret, but it never leaves apps/api.
SUPABASE_ANON_KEY=CHANGE_ME
# "Secret key" (sb_secret_...) or legacy "service_role" key. Services: api, worker.
# Used only for Auth (GoTrue) and Storage signed URLs, never to reach a table.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
# JWT signing keys endpoint (requires asymmetric JWT signing keys). Service: api.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# --- Database ----------------------------------------------------------------
# The roles below are created by the Lot 0 migrations: leave empty until then.
# Pooled connection as role `influx_app` (not owner, no BYPASSRLS, no SUPERUSER).
# Service: api.
DATABASE_URL=postgresql://influx_app:CHANGE_ME@HOST:PORT/postgres
# Second pool: roles `influx_auth`, `influx_worker`, `influx_privacy` (none with
# BYPASSRLS). Services: api, worker.
ELEVATED_DATABASE_URL=postgresql://influx_worker:CHANGE_ME@HOST:PORT/postgres
# DIRECT_DATABASE_URL (migration role, owner of the objects) is deliberately
# absent: it lives only in GitHub Secrets (CI) and is never set on a runtime
# service (check CI-5).

# --- Brevo (16 §M8) ----------------------------------------------------------
# `disabled` (default, no outbound call) | `redirect` (staging only, internal
# recipients only) | `live` (production only). The service refuses to start
# with `live` outside production (16 RG116).
BREVO_MODE=disabled
# Production key: Railway `production` only, never in a local file (RG115).
# Development machine: key of the dedicated Brevo TEST account (D62), which
# holds no real data and authenticates none of the production sub-domains.
# Never set in CI or on a Railway service outside production.
BREVO_API_KEY=CHANGE_ME
BREVO_API_BASE_URL=https://api.brevo.com/v3
# Closed list of internal addresses, comma-separated. Required if `redirect`.
BREVO_TEST_RECIPIENTS=team@example.com
# Inbound webhook protection: Brevo does not sign its webhooks (16 RG146).
# The two tokens are rotated together; two values accepted during rotation.
BREVO_WEBHOOK_SECRET=CHANGE_ME
BREVO_WEBHOOK_PATH_TOKEN=CHANGE_ME
# Brevo published IP ranges, comma-separated CIDR. Monitored.
BREVO_IP_ALLOWLIST=192.0.2.0/24
# One sender sub-domain per flow (16 RG9): tx. / news. / pro.
BREVO_SENDER_TRANSACTIONAL=no-reply@tx.example.com
BREVO_SENDER_MARKETING=hello@news.example.com
# PRODUCTION ONLY.
BREVO_SENDER_PROSPECTING=contact@pro.example.com
# Suppression list joined to every send built on a Brevo segment (16 RG45).
BREVO_SUPPRESSION_LIST_ID=0

# --- Apollo.io and lead pipeline ---------------------------------------------
# `dry_run` outside production (no outbound call) | `live` in production.
# Read at startup, immutable. Service: worker.
SYNC_MODE=dry_run
# Production key: Railway `production` only. No Apollo key at all in `staging`:
# the connector then reports `skipped_no_credentials`. Service: worker.
# Development machine: key of the dedicated Apollo TEST account (D62), with no
# real person's data, no connected mailbox and no active sequence.
APOLLO_API_KEY=CHANGE_ME
# Recipient domains allowed outside production, comma-separated. Positive
# condition, evaluated in the connector right before the outbound call.
NON_PRODUCTION_RECIPIENT_ALLOWLIST=example.com
