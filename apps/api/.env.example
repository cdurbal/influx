# =============================================================================
# apps/api — environment template (services `api` and `worker`)
# -----------------------------------------------------------------------------
# FAKE VALUES ONLY. Never a real secret, never a production value (skill env-secrets).
# Local: copy to apps/api/.env.local (ignored by Git, NEVER .env: the demo branch loads it).
#   `pnpm dev` and `pnpm dev:worker` both read .env.local (--env-file-if-exists).
# Railway: each variable on the ONLY service that reads it (see "service" below).
# Every value holding CHANGE_ME is refused at startup: a copied template never starts.
# A commented line (# NAME=…) is optional: absent means the safe default described above it.
# Read by src/config/schema.ts; every name is checked against this file (18 T11.4).
# =============================================================================

# -----------------------------------------------------------------------------
# Platform (api and worker)
# -----------------------------------------------------------------------------

# staging | production. The local stack runs as staging.
INFLUX_ENV=staging

# api only. Port of the HTTP server (default 3100). Never a public host (02 §12.3).
PORT=3100

# api only. Public origin of each surface, expected on its writes (03 §6.4 A4).
# Origin only (scheme, host, port), https in production, the two must differ.
INFLUX_PUBLIC_SITE_URL=http://localhost:3000
INFLUX_PUBLIC_BACKOFFICE_URL=http://localhost:3001

# api only. One relay secret per front (03 PP-8), at least 32 bytes, all different.
# The same values go to INFLUX_API_INTERNAL_SECRET of apps/web and apps/backoffice.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INFLUX_API_INTERNAL_SECRET_WEB=CHANGE_ME_web_relay_secret_at_least_32_bytes
INFLUX_API_INTERNAL_SECRET_BACKOFFICE=CHANGE_ME_backoffice_relay_secret_32_bytes

# api only. Pepper of the rate-limiting digests (03 A5). At least 32 bytes, distinct.
# Rotation: counters reset (procedure A).
AUTH_THROTTLE_PEPPER=CHANGE_ME_throttle_pepper_at_least_32_bytes_x

# api only. Signs the short tokens only (login journey, sign-up), never the session (EC-24).
# At least 32 bytes, distinct. Rotation: login journeys in progress lost (procedure A).
AUTH_TOKEN_SIGNING_SECRET=CHANGE_ME_token_signing_secret_32_bytes_xx

# Set by Railway on every service, never by hand (D60: version and replica in the logs).
# RAILWAY_GIT_COMMIT_SHA=0123456789abcdef0123456789abcdef01234567
# RAILWAY_REPLICA_ID=00000000-0000-0000-0000-000000000000
# RAILWAY_ENVIRONMENT_NAME=staging

# -----------------------------------------------------------------------------
# Supabase — server only, NEVER in a front, never NEXT_PUBLIC_ (skill env-secrets rule 2)
# -----------------------------------------------------------------------------

# api and worker (E-4 purge: both SUPABASE_* or none on the worker, required in production).
# Origin of the project: https, or http on a loopback host (local stack).
SUPABASE_URL=http://127.0.0.1:54321

# api and worker (E-4 purge). A secret API key sb_secret_…, one per service;
# the legacy service_role JWT is refused (EC-46). GoTrue only, never a table.
SUPABASE_SECRET_KEY=sb_secret_CHANGE_ME

# -----------------------------------------------------------------------------
# Database — one connection role per variable, one service per variable (EC-20)
# Local stack: postgresql://<role>:<password>@127.0.0.1:54322/postgres (direct, no suffix).
# Railway: through the pooler, user <role>.<project ref>, port 6543, TLS verified.
# On Railway, a variable of another service makes the process refuse to start.
# -----------------------------------------------------------------------------

# api only. influx_app: the four business roles, never elevated.
DATABASE_URL=postgresql://influx_app.your-project-ref:CHANGE_ME@HOST:6543/postgres
# api only. influx_auth_login: E-1 and E-2 (login code, sign-up, Brevo webhook).
AUTH_DATABASE_URL=postgresql://influx_auth_login.your-project-ref:CHANGE_ME@HOST:6543/postgres
# api only. influx_ops_login: E-6, the monitoring of D60.
OPS_DATABASE_URL=postgresql://influx_ops_login.your-project-ref:CHANGE_ME@HOST:6543/postgres
# worker only. influx_worker_login: E-3 and E-4.
WORKER_DATABASE_URL=postgresql://influx_worker_login.your-project-ref:CHANGE_ME@HOST:6543/postgres
# worker only. influx_privacy_login: E-5, the execution of the "mes données" requests approved by
# an admin (J8). Never influx_worker_login. Required in production; unset elsewhere: none runs.
PRIVACY_DATABASE_URL=postgresql://influx_privacy_login.your-project-ref:CHANGE_ME@HOST:6543/postgres

# api and worker, optional (EC-34). Root certificate (PEM) of the pooler's TLS when the
# system store does not know it. Absent: the system store. Never a private key.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nMIIB…fake…\n-----END CERTIFICATE-----

# -----------------------------------------------------------------------------
# Brevo — server only; api and worker each hold THEIR OWN key (EC-19)
# -----------------------------------------------------------------------------

# disabled | redirect | live. live is refused outside production, required in production.
# Default: disabled (nothing is sent, nothing is called).
BREVO_MODE=disabled

# Closed list of internal addresses, comma-separated. Required when BREVO_MODE=redirect.
BREVO_TEST_RECIPIENTS=qa@influx.example

# The official URL; outside production, the local double on a loopback host is accepted.
BREVO_API_BASE_URL=https://api.brevo.com/v3

# Required unless BREVO_MODE=disabled. Locally: the key of a Brevo TEST account only (D62),
# never the production key. One key per service (api, worker).
# BREVO_API_KEY=xkeysib-CHANGE_ME

# Required unless BREVO_MODE=disabled. Sender of the transactional flow (tx. sub-domain, RG9).
# BREVO_SENDER_TRANSACTIONAL=no-reply@tx.influx.example

# worker only, optional. Brevo list joined to every marketing send (16 RG45).
# BREVO_SUPPRESSION_LIST_ID=12

# worker only, optional (D68). Brevo list ids written into leads.sync_settings at worker start:
# a variable set wins over a value set by SQL; an absent one leaves the base alone. Positive
# integers, read in the Brevo account of THIS environment (test account outside production).
# No template id (D69): every e-mail is written by INFLUX; BREVO_TEMPLATE_ID_* are refused.
# BREVO_LIST_ID_ADVERTISERS=3
# BREVO_LIST_ID_CREATORS=4
# Withdrawn by D69, NEVER set: the worker refuses to start while any of them is present.
# BREVO_TEMPLATE_ID_WELCOME_ADVERTISER=
# BREVO_TEMPLATE_ID_WELCOME_CREATOR=
# BREVO_TEMPLATE_ID_EMAIL_CHANGED_NOTICE=

# -----------------------------------------------------------------------------
# Brevo webhook (J7 decision 1, 16 RG146) — api ONLY (refused on the Railway worker)
# Two secrets, two values each; _PREVIOUS only during a rotation (env-secrets procedure B).
# Both _CURRENT absent: the webhook is closed (answered as an unknown route); refused in
# production. All four values differ from each other and from every other secret.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# -----------------------------------------------------------------------------

# Path segment, routing only (Railway logs paths): exactly 43 base64url characters.
# BREVO_WEBHOOK_PATH_TOKEN_CURRENT=CHANGE_ME_path_token_43_base64url_chars_xxx
# BREVO_WEBHOOK_PATH_TOKEN_PREVIOUS=
# Header brevo-webhook-token, the authentication: 43 to 128 base64url characters.
# BREVO_WEBHOOK_SECRET_CURRENT=CHANGE_ME_header_secret_43_to_128_base64url
# BREVO_WEBHOOK_SECRET_PREVIOUS=

# -----------------------------------------------------------------------------
# Lead synchronisation — worker only
# -----------------------------------------------------------------------------

# live | dry_run. dry_run is refused in production; default dry_run.
SYNC_MODE=dry_run

# Required when SYNC_MODE=live outside production: e-mail DOMAINS, comma-separated.
# NON_PRODUCTION_RECIPIENT_ALLOWLIST=influx.example

# Optional. Absent (as in staging): the Apollo connector skips (skipped_no_credentials).
# Locally: the key of an Apollo TEST account only (D62), never in CI nor on Railway.
# APOLLO_API_KEY=CHANGE_ME
