{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Node runs these sources by type stripping: erasable syntax only (21 §4, J1-B).
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "*.config.ts"]
}
