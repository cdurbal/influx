{
  "name": "@influx/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local src/main.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env.local src/worker.ts",
    "start": "node src/main.ts",
    "start:worker": "node src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit && pnpm run test:db",
    "test:unit": "vitest run --project unit",
    "db:demo-accounts": "node scripts/seed-demo-accounts.ts",
    "test:db": "vitest run --project db --reporter=default --reporter=json --outputFile.json=test-results/db-report.json && node scripts/check-db-case-floors.ts",
    "db:staging-demo-accounts": "node scripts/seed-staging-demo-accounts.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@influx/contracts": "workspace:*",
    "@supabase/auth-js": "2.117.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@influx/test-kit": "workspace:*",
    "@types/node": "22.20.3",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
