{
  "name": "@influx/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local src/main.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env.local src/worker.ts",
    "start": "node src/main.ts",
    "start:worker": "node src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm run test:unit && pnpm run test:db",
    "test:unit": "vitest run --project unit --reporter=default --reporter=json --outputFile.json=test-results/unit-report.json && node scripts/check-case-floors.ts unit",
    "db:demo-accounts": "node scripts/seed-demo-accounts.ts",
    "test:db": "vitest run --project db --reporter=default --reporter=json --outputFile.json=test-results/db-report.json && node scripts/check-case-floors.ts db",
    "db:staging-demo-accounts": "node --env-file=.env.local scripts/seed-staging-demo-accounts.ts",
    "db:publish-terms": "node scripts/publish-terms.ts",
    "db:publish-terms:staging": "node --env-file=.env.local scripts/publish-terms.ts --target=staging",
    "staging:check": "node --env-file=.env.local scripts/staging-check.ts",
    "staging:reset-internal-account": "node --env-file=.env.local scripts/reset-staging-internal-account.ts",
    "trial:record": "node --env-file-if-exists=.env.trial.local scripts/record-provider-exchanges.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@influx/contracts": "workspace:*",
    "@supabase/auth-js": "2.117.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@influx/test-kit": "workspace:*",
    "@types/node": "22.20.3",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
