{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @influx/backoffice build",
    "watchPatterns": [
      "apps/backoffice/**",
      "packages/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      ".node-version",
      "deploy/railway/backoffice.production.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @influx/backoffice start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
