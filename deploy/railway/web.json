{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @influx/web build",
    "watchPatterns": [
      "apps/web/**",
      "packages/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      ".node-version",
      "deploy/railway/web.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @influx/web start",
    "healthcheckPath": "/fr",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
