# =============================================================================
# INFLUX MVP - Configuration des variables d'environnement (Exemple)
# =============================================================================
# Copier ce fichier vers .env ou .env.local avant de lancer les applications.
# Règle de sécurité (env-secrets) : Ne JAMAIS committer de valeurs réelles de production.

# Environnement de déploiement : development | test | staging | production
INFLUX_ENV=development

# Port d'écoute de l'API Fastify
PORT=4000

# Secret de signature des cookies de session (min 32 caractères requis)
SESSION_COOKIE_SECRET=change-me-to-a-secure-random-32-chars-secret-key!

# Origines autorisées CORS pour l'API (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Ports des applications frontend
PORT_WEB=3000
PORT_BACKOFFICE=3002

